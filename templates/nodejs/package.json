{%- set keywords = [
    d for d in [
        d | trim for d in keywords | split(pat=',')
    ]
    if d
] if keywords else [] -%}

{%- set scripts = [
    s for s in [
      ["build", build_script | default(value="")],
      ["start", start_script | default(value="")],
      ["test", test_script | default(value="")],
      ["format", format_script | default(value="")],
      ["lint", lint_script | default(value="")]
    ]
    if s[1]
] -%}

{%- set deps = [
    d for d in [
        d | trim for d in deps | split(pat=',')
    ]
    if d
] if deps else [] -%}

{%- set devdeps = [
    d for d in [
        d | trim for d in devdeps | split(pat=',')
    ]
    if d
] if devdeps else [] -%}

{
    "name": "{{ name }}",
    "version": "{{ version | default(value="1.0.0") }}",
    "description": "{{ description | default(value="") }}",
    "keywords": {{ keywords }},
    "license": "{{ license | default(value="ISC") }}",
    "author": "{{ author | default(value="") }}",
    "main": "{{ main | default(value="index.js") }}",
    "type": "module",
    "scripts": {
    {%- for s in scripts %}
        "{{ s[0] }}": "{{ s[1] }}"
        {{- "" if loop.last else "," }}
    {%- endfor %}
    },
    "dependencies": {
    {%- for pkg in deps %}
        "{{ pkg }}": "*"
        {{- "" if loop.last else "," }}
    {%- endfor %}
    },
    "devDependencies": {
    {%- for pkg in devdeps %}
        "{{ pkg }}": "*"
        {{- "" if loop.last else "," }}
    {%- endfor %}
    }
}
