set quiet

setup:
    #!/usr/bin/env bash
    set -euo pipefail

    git config core.hooksPath .githooks

build:
    go build .

run:
    go run .

tidy:
    go mod tidy

format:
    goimports -w .
    gofumpt -w .

lint:
    goimports -d .
    gofumpt -d .

test:
    go test .

clean:
    go clean
