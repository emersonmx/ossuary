setup:
    #!/usr/bin/env bash
    set -euo pipefail

    git config core.hooksPath .githooks

    if ! command -v kache &> /dev/null; then
        echo "kache not found, installing..."
        RUSTC_WRAPPER= cargo install --locked kache
    fi

    if ! command -v bacon &> /dev/null; then
        echo "bacon not found, installing..."
        cargo install --locked bacon
    fi

    if ! command -v cargo-nextest &> /dev/null; then
        echo "cargo-nextest not found, installing..."
        cargo install --locked cargo-nextest
    fi
